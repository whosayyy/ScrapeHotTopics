# Server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# Production database (uncomment when deploying)
# DATABASE_URL="postgresql://user:password@localhost:5432/hotradar"

# AI — Deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000

# Crawler
CRAWLER_INTERVAL_MIN=1
CRAWLER_INTERVAL_MAX=5

# Twitter API (optional, for Twitter adapter)
# TWITTER_BEARER_TOKEN=your-token

# Email (offline digest push)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
