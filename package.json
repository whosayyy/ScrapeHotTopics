{
  "name": "hot-radar",
  "version": "0.1.0",
  "private": true,
  "description": "热点雷达 — 全自动跨平台热点追踪与分析系统",
  "workspaces": [
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w packages/server",
    "dev:client": "npm run dev -w packages/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build -w packages/server && npm run build -w packages/client",
    "db:migrate": "npm run db:migrate -w packages/server",
    "db:push": "npm run db:push -w packages/server",
    "db:studio": "npm run db:studio -w packages/server",
    "lint": "eslint packages/*/src --ext .ts,.tsx"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
